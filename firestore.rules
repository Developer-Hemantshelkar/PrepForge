rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'targetRole',
          'targetStacks',
          'masteredConcepts',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'targetRole',
          'targetStacks',
          'masteredConcepts',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 150
        && data.targetRole is string
        && data.targetRole.size() >= 1
        && data.targetRole.size() <= 80
        && data.targetStacks is list
        && data.targetStacks.size() <= 8
        && (data.targetStacks.size() == 0 || data.targetStacks[0] is string)
        && data.masteredConcepts is list
        && data.masteredConcepts.size() <= 200
        && (data.masteredConcepts.size() == 0 || data.masteredConcepts[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttempt(data, userId, attemptId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'type',
          'stack',
          'title',
          'score',
          'maxScore',
          'durationSec',
          'summary',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'type',
          'stack',
          'title',
          'score',
          'maxScore',
          'durationSec',
          'summary',
          'createdAt'
        ])
        && data.id is string
        && data.id == attemptId
        && data.id.size() <= 128
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() <= 128
        && data.type in ['quiz', 'test-module', 'coding', 'behavioral']
        && data.stack is string
        && data.stack.size() >= 1
        && data.stack.size() <= 64
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.score is number
        && data.score >= 0
        && data.score <= 100
        && data.maxScore is number
        && data.maxScore >= 1
        && data.maxScore <= 100
        && data.durationSec is number
        && data.durationSec >= 0
        && data.durationSec <= 14400
        && data.summary is string
        && data.summary.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidCareerDoc(data, userId, docId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'docType',
          'title',
          'targetRole',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'docType',
          'title',
          'targetRole',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == docId
        && data.id.size() <= 128
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() <= 128
        && data.docType in ['resume-review', 'cover-letter', 'prep-note']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.targetRole is string
        && data.targetRole.size() <= 120
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 15000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'targetRole',
          'targetStacks',
          'masteredConcepts',
          'updatedAt'
        ]);
      allow delete: if false;

      match /attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attemptId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidAttempt(incoming(), userId, attemptId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isVerifiedUser() && isOwner(userId);
      }

      match /careerDocs/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidCareerDoc(incoming(), userId, docId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidCareerDoc(incoming(), userId, docId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().docType == existing().docType
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'targetRole',
            'content',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && isOwner(userId);
      }
    }
  }
}
